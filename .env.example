# Neon Postgres connection string (console.neon.tech → your project → Connect)
# This is the DEV branch — what `npm run dev` and `npm run db:push` use.
DATABASE_URL=

# Same project, the `production` branch — the one Vercel reads. Only used by
# `npm run db:push:prod`; the app itself never reads it. Every schema change has
# to go to both branches or production 500s on the missing table.
PROD_DATABASE_URL=

# Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
